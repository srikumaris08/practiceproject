<% layout("./layouts/boilerplate")%>
<body>
    <div class="row">
     <div class="col col-8 offset-2">
        <h2 style="margin-left: 0rem;">Details</h2>
        <br>
    </div>
    
    <div class="card col col-6 offset-2 showcard">
      <img src="<%=list.image.url %>" class="card-img-top show-img" alt="img">
      <div class="card-body">
         <br>
         <p class="card-text"><b><%= list.title %></b><br>
         <i>Owned By:</i> <%= list.owner.username %><br>
         <%= list.description %><br>
         &#8377;<%= list .price.toLocaleString("en-IN")%><br>
         <%= list.location %><br>
         <%= list.country %><br><br>
        </p>
      </div>
   </div>
   
   </div>
     <div class="row">
      <!-- <div class="col-8 offset-2"> -->
      <% if(currentuser && currentuser._id.equals(list.owner._id)) { %>
       <div class="btns">
        <a href="/listings/<%=list._id%>/edit" class="btn btn-dark col-1 offset-2 edit-btn" style="margin-right: 2rem;"> Edit</a>


     <form method="post" action="/listings/<%=list._id%>?_method=DELETE">
        <button class="btn btn-dark offet-5 ">Delete</button>
    </form>

   </div>
   <% } %>
      <!-- </div> -->
     </div>
     <br><br><hr>
    
   <div class="col-8 offset-2" >
      <% if(currentuser){ %>

     <h3>Leave a review</h3>
     <form method="post" action="/listings/<%=list._id%>/reviews" novalidate class="needs-validation">
      <div class="mb-3 mt-3">
         <label for="rating" class="form-label" >Rating</label>
         
      </div>
      <fieldset class="starability-slot">
  
  <input type="radio" id="no-rate" class="input-no-rate"  name="review[rating]"  value="0" checked aria-label="No rating." />
  <input type="radio" id="first-rate1" name="review[rating]" value="1" />
  <label for="first-rate1" title="Terrible">1 star</label>
  <input type="radio" id="first-rate2"  name="review[rating]" value="2" />
  <label for="first-rate2" title="Not good">2 stars</label>
  <input type="radio" id="first-rate3"  name="review[rating]" value="3" />
  <label for="first-rate3" title="Average">3 stars</label>
  <input type="radio" id="first-rate4"  name="review[rating]" value="4" />
  <label for="first-rate4" title="Very good">4 stars</label>
  <input type="radio" id="first-rate5"  name="review[rating]" value="5" />
  <label for="first-rate5" title="Amazing">5 stars</label>
</fieldset>
     <div class="mb-3 mt-3">
      <label for="comment" class="form-label">Comment</label>
      <textarea rows="5" cols="30" id="comment" name="review[comment]" class="form-control" required></textarea>
      <div class="invalid-feedback">Please add something</div>
     </div>
     
     <button class="btn btn-outline-dark">Submit</button>
   </form>
   <%} %>
   </div>
   <hr>
   <div class="col-8 offset-2">
   <p><b>All reviews</b><p>
   <div class="row">
      <%for(review of list.reviews) {%>
      <div class="card col-5 mb-3 ms-3">
         <div class="card-body">
            <h3 class="card-title"> <%= review.author.username%> </h3>
            <p class="starability-result card-text" data-rating=<%=review.rating%>></p>
            <p class="card-text"> <%=review.comment%></p>
            
         </div>
         <form class="mb-3" method="post" action="/listings/<%=list._id%>/reviews/<%=review._id%>?_method=DELETE"><br>
            <button class=" btn btn-dark">Delete</button>
         </form>
      </div>
     <% }%>
   </div>
   </div>
   <br><br>
  
</body>
